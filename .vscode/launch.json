    "version": "0.2.0",
    "configurations": [

        {
            "type": "java",
            "name": "Launch Java Program",
            "request": "launch",
            "mainClass": ""
        },

        
        {
            "type": "java",
            "name": "Launch Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "Launch HanziSpider",
            "request": "launch",
            "mainClass": "de.brainschweig.hanzispider.HanziSpider",
            "projectName": "HanziSpider",
            "env": {
                 "DB_CONNECTION_STRING": "jdbc:mysql://127.0.0.1/crawler?user=crawler&password=crawlerX",
                 "WEBHANDLER": "JSoup",
                 "OUTPUTHANDLER": "MySQLDatabase",
                 //"OUTPUTHANDLER": "File",
                 "PROXY": "",
                 "PROXYPORT": ""
            }
        }
    ]
}